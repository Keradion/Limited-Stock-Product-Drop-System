# Render PostgreSQL — External Database URL from Render dashboard +:
# ?schema=public&sslmode=require
# If API and DB are both on Render, use the Internal Database URL (no sslmode needed).
DATABASE_URL="postgresql://USER:PASSWORD@dpg-xxxxx.ohio-postgres.render.com:5432/DATABASE?schema=public&sslmode=require"

# Redis Cloud — copy the exact URL from redis-cli -u or the dashboard.
# This host (port 14351) uses redis:// (no TLS). Do not use rediss:// unless Redis shows a TLS URL.
REDIS_URL="redis://default:your_password@redis-14351.c93.us-east-1-3.ec2.cloud.redislabs.com:14351"

# Render injects PORT — use 10000 or whatever Render shows for your web service
PORT=10000

# Allowed frontend origins (comma-separated)
# Local: http://localhost:5173
# Render frontend: https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5173

# App
NODE_ENV=production
LOG_LEVEL=info
SERVICE_NAME=limited-stock-drop
REQUEST_LOG_SKIP_PATHS=/health,/metrics

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="1d"

# Auth
BCRYPT_SALT_ROUNDS=10

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Rate limiting
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_RESERVE_WINDOW_MS=60000
RATE_LIMIT_RESERVE_MAX=3
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=5

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Seed
SEED_USER_PASSWORD="password123"

# Reservations
RESERVATION_TTL_MS=300000
RESERVATION_EXPIRY_QUEUE_NAME=reservation-expiry
